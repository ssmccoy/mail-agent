#!/bin/sh
set -eu

work=$1
out=$2
prompt=$3

if [ -f "$CASE_ROOT/check-descriptors" ]; then
    for descriptor in /proc/self/fd/*; do
        if [ "$(readlink "$descriptor" 2>/dev/null)" = "$HOME/mail/.agent/lock/$(basename "$work")" ]; then
            echo "inherited dispatcher lock" >&2
            exit 70
        fi
    done
fi

printf "%s\n" "$@" >> "$CASE_ROOT/driver-arguments"
cat "$prompt" >> "$CASE_ROOT/prompts"

if [ -f "$CASE_ROOT/inspect-attachments" ]; then
    attachments=$(sed -n 's/^Attachments are available in \(.*\):$/\1/p' "$prompt")

    find "$attachments" -maxdepth 1 -type f -exec sh -c '
        for attachment do
            printf "%s: " "${attachment##*/}"
            cat "$attachment"
        done
    ' sh {} + > "$CASE_ROOT/attachments"
fi

if [ -f "$CASE_ROOT/status" ]; then
    status=$(cat "$CASE_ROOT/status")

    if [ "$status" -ne 0 ]; then
        echo "fixture driver failed" >&2
        exit "$status"
    fi
fi

if [ -f "$CASE_ROOT/commit" ]; then
    printf "changed\n" > "$work/repo/file"
    git -C "$work/repo" add file
    if [ -s "$CASE_ROOT/commit" ]; then
        git -C "$work/repo" commit -qF "$CASE_ROOT/commit"
    else
        git -C "$work/repo" commit -qm "Change example file"
    fi

    rm "$CASE_ROOT/commit"
fi

printf "The requested inspection is complete.\n" > "$out/reply.md"
printf "0.25\n" > "$out/cost"
printf "fixture-session\n" > "$work/agent-session"
