# The reader's side of the mail agent. Source this from ~/.muttrc, or
# copy the pieces you want.

# Maildir, with a spool per agent beside the inbox.
set mbox_type   = Maildir
set folder      = ~/mail
set spoolfile   = +inbox
mailboxes +inbox +claude +codex +archive +sent +drafts +trash

# A turn is a thread, so read the folder threaded. sort_aux floats the
# thread with the newest reply to the bottom; strict_threads off lets a
# reply whose parent is filed elsewhere still join by subject, since a
# sent message lives in +sent, not the inbox it is answering into.
set sort         = threads
set sort_aux     = last-date-received
set strict_threads = no

# Reach the agents by name, one line per row of the agents table. A
# backquoted command in a configuration file is run when mutt reads it,
# though $(...) is not, so the host is not written out twelve times.
alias claude     Claude     <you+claude@`cat /etc/mailname`>
alias fable      Fable      <you+fable@`cat /etc/mailname`>
alias opus       Opus       <you+opus@`cat /etc/mailname`>
alias sonnet     Sonnet     <you+sonnet@`cat /etc/mailname`>
alias haiku      Haiku      <you+haiku@`cat /etc/mailname`>

alias codex      Codex      <you+codex@`cat /etc/mailname`>
alias astra      Astra      <you+astra@`cat /etc/mailname`>
alias sol        Sol        <you+sol@`cat /etc/mailname`>
alias terra      Terra      <you+terra@`cat /etc/mailname`>
alias luna       Luna       <you+luna@`cat /etc/mailname`>
alias mini       Mini       <you+mini@`cat /etc/mailname`>
alias codex-mini Codex-mini <you+codex-mini@`cat /etc/mailname`>

# Forwarding to an agent has to keep the subject, since the first word
# of it names the project; the default format replaces it with the
# sender's address.
set forward_format = "Fwd: %s"

# Replies arrive minutes after the message that caused them.
set timeout   = 15
set beep_new  = yes

# Pop a desktop notification while mutt is open. For replies that arrive
# when mutt is closed, install the path unit as well: make notify.
set new_mail_command = "notify-send -a mutt 'New mail: %f' '%n new'"

# Apply a mailed series. pipe_decode stays off so the raw message
# arrives with its headers; pipe_split is on so a tagged series reaches
# git am one patch at a time, rather than being squashed into one
# commit.
set pipe_split = yes
macro index,pager A "<pipe-message>git-am-mail .<enter>" "apply the series here"
macro index,pager \eA "<pipe-message>git-am-mail<enter>" "apply it where it was written"
macro attach W "<enter-command>set pipe_decode<enter><pipe-entry>w3m -T text/html<enter><enter-command>unset pipe_decode<enter>" "read this part in w3m"

# A command that succeeds has nothing to say; one that fails prints why,
# and mutt still waits on that.
unset wait_key

# Deleting a thread retires the agent's side of it as well: the
# worktree, anything queued, and the session itself. The mail is
# recoverable until the mailbox is synced; the thread is not.
macro index,pager \cd "<pipe-message>mail-agent-forget-mail<enter><delete-thread>" "forget the thread and delete it"

# Render the parts the agent sends; see mailcap.example.
auto_view text/markdown text/html application/mbox
alternative_order text/plain text/html

# Diff colours belong to patch mail and nowhere else: the rule that
# paints a removal cannot tell one from a markdown bullet.
message-hook '~s "\\[PATCH"'   'source ~/.mutt/diff.muttrc'
message-hook '!~s "\\[PATCH"' 'source ~/.mutt/nodiff.muttrc'
