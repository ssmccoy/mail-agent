#!/bin/sh
#
# Run one turn of a mail thread with pi and write what the harness needs
# to compose a reply.
#
# Usage: mail-agent-pi <work> <out> <prompt> <mode>
#
# The harness passes a model and an effort level after the mode; a local
# model offers neither, so both are ignored.
#
# The interface matches mail-agent-claude: the session lives in
# <work>/agent-session, the outputs land in <out>, and the exit status
# says whether a retry is worth anything.
#
# pi drives a local model, so it reaches the server on localhost rather
# than the internet, and a turn costs tokens rather than money.

PATH=/usr/bin:/bin

export PATH

work=$1
out=$2
prompt=$3
mode=$4

if [ -z "$mode" ]; then
    echo "usage: mail-agent-pi <work> <out> <prompt> <mode>" >&2
    exit 64
fi

attachments=$(dirname "$prompt")/attachments

MAIL_AGENT_DRIVER_HOME=$("$HOME/bin/mail-agent-state" pi "$work") || exit $?

export MAIL_AGENT_DRIVER_HOME

limit=${MAIL_AGENT_TIMEOUT:-60m}
repo=$(cat "$work/project" 2>/dev/null)
access=$mode

if [ -z "$repo" ]; then
    access=research
fi

# Research has private temporary storage and no writable checkout.
if [ "$access" = research ]; then
    mkdir -p "${MAIL_AGENT_OUTPUT_DIR:-/tmp/mail-agent}" || exit 70

    MAIL_AGENT_RESEARCH_TMP=$(mktemp -d "${MAIL_AGENT_OUTPUT_DIR:-/tmp/mail-agent}/research.XXXXXXXX") || exit 70

    export MAIL_AGENT_RESEARCH_TMP

    trap 'rm -rf "$MAIL_AGENT_RESEARCH_TMP"' EXIT
fi

# Grant the source repository only when the thread has one.
if [ -n "$repo" ]; then
    with_repo="-r $repo"

    if [ "$access" = research ]; then
        objects=$(git -C "$work/repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)

        if [ -n "$objects" ]; then
            with_repo="$with_repo -r $objects"
        fi
    fi
else
    with_repo=""
fi

if [ -d "$attachments" ]; then
    with_attachments="-r $attachments"
else
    with_attachments=""
fi

if [ -d "$HOME/.pi/agent/extensions" ]; then
    with_repo="$with_repo -r $HOME/.pi/agent/extensions"
fi

model=${MAIL_AGENT_PI_MODEL:-ggml-org/Qwen3.5-0.8B-GGUF}

# The clone is mounted rox rather than rwx for the modes that refuse
# edits, the same distinction landlock draws for codex; the tool
# denylist tells pi so it declines rather than being denied mid-write.
profile() {
    case $1 in
        research) echo mail-agent-pi-research ;;
        execute) echo mail-agent-pi ;;
        *)       echo mail-agent-pi-ro ;;
    esac
}

# Each turn forks the session it answers rather than advancing it, so
# every response stays a point a later reply can branch from; the fork's
# id is read back from the stream. agent-session names the parent to
# fork, absent on the first turn.
if [ -f "$work/agent-session" ]; then
    session="--fork $(cat "$work/agent-session")"
else
    session="--session-id $(od -An -tx1 -N16 /dev/urandom | tr -d " \n" | sed -E \
        "s/(.{8})(.{4}).(.{3}).(.{3})(.{12})/\1-\2-4\3-a\4-\5/")"
fi

# One session store, shared by every thread and its forks, so a fork can
# resume a parent session another worktree began. It is writable even
# when the checkout is not, granted rw of its own below. The mail rules
# are the installed file, the same for every thread, handed to pi rather
# than left for discovery to climb out of the worktree.
mkdir -p "$MAIL_AGENT_DRIVER_HOME/sessions"

(
    cd "$work/repo" || exit 70

    PATH="$HOME/.proto/shims:$HOME/.proto/bin:/usr/bin" "$HOME/bin/mail-agent-tools" pi "$mode" timeout "$limit" "$HOME/bin/landlock" \
        -c "$HOME/.config/landlock/$(profile "$access").cfg" \
        $with_repo $with_attachments -r "$work" -w "$MAIL_AGENT_DRIVER_HOME" \
        "$HOME/.local/bin/pi" -p --mode json \
        --provider llama-cpp --model "$model" \
        $session --session-dir "$MAIL_AGENT_DRIVER_HOME/sessions" \
        --append-system-prompt "$HOME/.config/mail-agent/instructions.md" \
        < "$prompt"
) > "$work/events.jsonl" 2> "$out/stderr"

status=$?

if [ "$status" -eq 124 ]; then
    exit 124
fi

if [ "$status" -ne 0 ]; then
    tail -5 "$out/stderr" >&2
    exit 75
fi

# pi streams the message in deltas and repeats the whole of it at
# message_end; the last assistant one is the reply.
jq -rs 'map(select(.type == "message_end" and .message.role == "assistant"))
        | last | (.message.content // [])
        | map(select(.type == "text") | .text) | join("\n")' \
    "$work/events.jsonl" > "$out/reply.md"

if [ ! -s "$out/reply.md" ]; then
    echo "pi wrote no final message" >&2
    tail -3 "$out/stderr" >&2
    exit 75
fi

jq -r 'select(.type == "session") | .id' "$work/events.jsonl" | tail -1 > "$out/thread"

if [ -s "$out/thread" ]; then
    cp "$out/thread" "$work/agent-session"
fi

jq -r --arg work "$work/" -f "$HOME/.config/mail-agent/steps-pi.jq" \
    "$work/events.jsonl" > "$out/steps.txt"

# A local model reports tokens at no cost, so the table counts tokens
# and the ledger prices the turn at zero.
jq -rs --arg session "$(cat "$work/agent-session")" '
    (map(select(.type == "message_end" and .message.role == "assistant"))
        | last | .message.usage) as $usage
    | (map(select(.type == "message_end" and .message.role == "assistant"))
        | length) as $messages
    | "<!doctype html><meta charset=\"utf-8\"><title>Turn cost</title>"
    + "<style>body{font:14px/1.5 ui-monospace,monospace;margin:1.5rem}"
    + "table{border-collapse:collapse}td,th{padding:.25rem .75rem;"
    + "border-bottom:1px solid #ddd;text-align:left}"
    + "td.n{text-align:right;font-variant-numeric:tabular-nums}</style>"
    + "<table>"
    + "<tr><td>input</td><td class=\"n\">\($usage.input)</td></tr>"
    + "<tr><td>output</td><td class=\"n\">\($usage.output)</td></tr>"
    + "<tr><td>reasoning</td><td class=\"n\">\($usage.reasoning)</td></tr>"
    + "<tr><td>messages</td><td class=\"n\">\($messages)</td></tr>"
    + "<tr><td>session</td><td class=\"n\">\($session)</td></tr>"
    + "</table>"' "$work/events.jsonl" > "$out/usage.html"

printf "0\n" > "$out/cost"
