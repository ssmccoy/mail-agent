#!/bin/sh
#
# Schedule queued messages whose delivery-time wakeup did not execute them.
# Completed and failed tasks are never executed again.
#
# Sessions already running are skipped rather than waited for.

PATH=/usr/bin:/bin

export PATH

agent="$HOME/mail/.agent"

for queue in "$agent"/queue/*/; do
    if [ ! -d "$queue" ]; then
        continue
    fi

    session=$(basename "$queue")

    if [ -z "$(ls -A "$queue")" ]; then
        continue
    fi

    if flock -n "$agent/lock/$session" true; then
        "$HOME/bin/mail-agent-dispatch" "$session" &
    fi
done

wait
