#!/bin/sh
#
# Everything known about one thread: where it is working, what it has
# spent, and what its last turn did.
#
# Usage: mail-agent-details [session]
#
# With no session, the running thread when exactly one is running.

PATH=/usr/bin:/bin

export PATH

agent="$HOME/mail/.agent"

running() {
    for lock in "$agent"/lock/*; do
        if [ -e "$lock" ] && ! flock -n "$lock" true 2>/dev/null; then
            basename "$lock"
        fi
    done
}

session=$1

if [ -z "$session" ]; then
    session=$(running | head -1)
fi

if [ -z "$session" ]; then
    echo "usage: mail-agent-details <session>" >&2
    exit 64
fi

work=$(ls -d "$agent"/work/"$session"* 2>/dev/null | head -1)

if [ -z "$work" ]; then
    echo "mail-agent-details: no thread $session" >&2
    exit 66
fi

session=$(basename "$work")
state=idle

if ! flock -n "$agent/lock/$session" true 2>/dev/null; then
    state=running
elif [ -n "$(ls -A "$agent/queue/$session" 2>/dev/null)" ]; then
    state=queued
fi

printf "session   %s\n" "$session"
printf "subject   %s\n" "$(cat "$work/subject" 2>/dev/null)"
waiting=$(ls -A "$agent/queue/$session" 2>/dev/null | wc -l)

# The message being answered stays queued until its reply is sent.
if [ "$state" = running ] && [ "$waiting" -gt 0 ]; then
    waiting=$((waiting - 1))
fi

printf "state     %s, %s waiting\n" "$state" "$waiting"
printf "project   %s\n" "$(cat "$work/project" 2>/dev/null || echo none)"
# The checkout is on a branch named for the session; the branch that
# matters is the one the thread was asked for.
printf "branch    %s\n" "$(cat "$work/branch" 2>/dev/null ||
    git -C "$work/repo" rev-parse --abbrev-ref HEAD 2>/dev/null)"
printf "base      %s\n" "$(cut -c1-12 "$work/base" 2>/dev/null)"

if [ -f "$work/cost" ]; then
    awk '{ total += $2 } END {
        printf "turns     %d, $%.2f in total\n", NR, total
    }' "$work/cost"

    printf "\nturns\n"
    awk '{ printf "  %s  $%.2f\n", substr($1, 1, 19), $2 }' "$work/cost"
fi

commits=$(git -C "$work/repo" log --oneline \
    "$(cat "$work/base" 2>/dev/null)..HEAD" 2>/dev/null)

if [ -n "$commits" ]; then
    printf "\ncommits since base\n"
    printf "%s\n" "$commits" | sed "s/^/  /"
fi

name=$(cat "$work/agent" 2>/dev/null)
steps="$HOME/.config/mail-agent/steps.jq"

if [ "$name" = codex ]; then
    steps="$HOME/.config/mail-agent/steps-codex.jq"
fi

records="$work/events.jsonl"

# Turns older than the kept stream are still in Claude's transcript.
if [ ! -f "$records" ] && [ "$name" != codex ]; then
    records=$(ls "$agent"/claude/projects/*/"$session.jsonl" 2>/dev/null | head -1)
fi

if [ -n "$records" ] && [ -f "$records" ]; then
    since=$(tail -1 "$work/cost" 2>/dev/null | cut -d" " -f1)

    printf "\nlast turn\n"

    jq -r --arg work "$work/" --arg since "${since:-}" -f "$steps" "$records" \
        | sed "s/^/  /"
fi
