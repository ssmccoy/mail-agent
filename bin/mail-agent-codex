#!/bin/sh
#
# Run one turn of a mail thread with codex and write what the harness
# needs to compose a reply.
#
# Usage: mail-agent-codex <work> <out> <prompt> <mode> [model]
#
# The interface matches mail-agent-claude: the session lives in
# <work>/agent-session, the outputs land in <out>, and the exit status
# says whether a retry is worth anything.

PATH=/usr/bin:/bin

export PATH

work=$1
out=$2
prompt=$3
mode=$4
model=$5

if [ -z "$mode" ]; then
    echo "usage: mail-agent-codex <work> <out> <prompt> <mode> [model]" >&2
    exit 64
fi

# A model of "-", or none, leaves the CLI's own default alone.
if [ -n "$model" ] && [ "$model" != "-" ]; then
    with_model="--model $model"
else
    with_model=""
fi

limit=${MAIL_AGENT_TIMEOUT:-60m}
# A research thread has no repository to read from, and nothing outside
# the working directory is granted to it.
repo=$(cat "$work/project" 2>/dev/null)

if [ -n "$repo" ]; then
    with_repo="-r $repo"
else
    with_repo=""
fi

# The final message is written by codex itself, so it has to land
# somewhere the sandbox can write: the harness scratch directory is
# outside it.
last=${MAIL_AGENT_OUTPUT_DIR:-/tmp/mail-agent}/reply-$$.md

# codex's own sandbox cannot initialise inside landlock's, so landlock
# is the only one, and the distinction between a turn that may write and
# one that may not is drawn there: the clone is mounted rox rather than
# rwx for the modes that refuse edits.
profile() {
    case $1 in
        execute) echo mail-agent-codex ;;
        *)       echo mail-agent-codex-ro ;;
    esac
}

# The global rules live in ~/.config/mail-agent/codex-instructions.md, to
# which CODEX_HOME/AGENTS.md is a symlink; no turn rewrites it. The mail
# rules, the same for every thread, are handed to codex as
# developer_instructions on the command line below, so they reach the
# prompt above a discovered AGENTS.md and the agent is not trusted to find
# them.

# Each turn forks the thread it answers rather than resuming it in place,
# so every response stays a point a later reply can branch from. A fork
# emits its own thread.started, captured below like any other id.
if [ -f "$work/agent-session" ]; then
    set -- exec fork "$(cat "$work/agent-session")" -
else
    set -- exec
fi

(
    cd "$work/repo" || exit 70

    PATH="$HOME/.proto/shims:$HOME/.proto/bin:/usr/bin" timeout "$limit" "$HOME/bin/landlock" \
        -c "$HOME/.config/landlock/$(profile "$mode").cfg" $with_repo \
        "$HOME/.local/bin/codex" "$@" --json -o "$last" $with_model \
        -c "developer_instructions=$(cat "$HOME/.config/mail-agent/instructions.md")" \
        --dangerously-bypass-approvals-and-sandbox \
        --skip-git-repo-check < "$prompt"
) > "$work/events.jsonl" 2> "$out/stderr"

status=$?

if [ "$status" -eq 124 ]; then
    exit 124
fi

if [ "$status" -ne 0 ]; then
    tail -5 "$out/stderr" >&2
    exit 75
fi

if [ ! -s "$last" ]; then
    echo "codex wrote no final message" >&2
    tail -3 "$out/stderr" >&2
    exit 75
fi

mv "$last" "$out/reply.md"

jq -r 'select(.type=="thread.started")|.thread_id' "$work/events.jsonl" \
    | tail -1 > "$out/thread"

if [ -s "$out/thread" ]; then
    cp "$out/thread" "$work/agent-session"
fi

jq -r --arg work "$work/" -f "$HOME/.config/mail-agent/steps-codex.jq" \
    "$work/events.jsonl" > "$out/steps.txt"

# codex reports tokens rather than money, so the table counts tokens.
jq -rs --arg session "$(cat "$work/agent-session")" '
    (map(select(.type=="turn.completed"))|last.usage) as $usage
    | (map(select(.type=="item.completed"))|length) as $steps
    | "<!doctype html><meta charset=\"utf-8\"><title>Turn cost</title>"
    + "<style>body{font:14px/1.5 ui-monospace,monospace;margin:1.5rem}"
    + "table{border-collapse:collapse}td,th{padding:.25rem .75rem;"
    + "border-bottom:1px solid #ddd;text-align:left}"
    + "td.n{text-align:right;font-variant-numeric:tabular-nums}</style>"
    + "<table>"
    + "<tr><td>input</td><td class=\"n\">\($usage.input_tokens)</td></tr>"
    + "<tr><td>cached input</td><td class=\"n\">\($usage.cached_input_tokens)</td></tr>"
    + "<tr><td>output</td><td class=\"n\">\($usage.output_tokens)</td></tr>"
    + "<tr><td>reasoning</td><td class=\"n\">\($usage.reasoning_output_tokens)</td></tr>"
    + "<tr><td>steps taken</td><td class=\"n\">\($steps)</td></tr>"
    + "<tr><td>thread</td><td class=\"n\">\($session)</td></tr>"
    + "</table>"' "$work/events.jsonl" > "$out/usage.html"

# Tokens are what codex reports, so the ledger counts turns at zero cost
# rather than inventing a price for them.
printf "0\n" > "$out/cost"
