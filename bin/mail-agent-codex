#!/bin/sh
#
# Run one turn of a mail thread with codex and write what the harness
# needs to compose a reply.
#
# Usage: mail-agent-codex <work> <out> <prompt> <mode> [model] [effort]
#
# The interface matches mail-agent-claude: the session lives in
# <work>/agent-session, the outputs land in <out>, and the exit status
# says whether a retry is worth anything.

. "${MAIL_AGENT_LIB:-$HOME/lib/mail-agent}/runtime.sh" || exit 78

PATH=/usr/bin:/bin

export PATH

work=$1
out=$2
prompt=$3
mode=$4
model=$5
effort=$6

if [ -z "$mode" ]; then
    echo "usage: mail-agent-codex <work> <out> <prompt> <mode> [model] [effort]" >&2
    exit 64
fi

attachments=$(dirname "$prompt")/attachments

# A model of "-", or none, leaves the CLI's own default alone.
if [ -n "$model" ] && [ "$model" != "-" ]; then
    with_model="--model $model"
else
    with_model=""
fi

# Reasoning depth is a config key rather than a flag. A level the model
# does not offer is refused by the CLI, and the turn is reported as
# failed with what it said.
if [ -n "$effort" ] && [ "$effort" != "-" ]; then
    with_effort="-c model_reasoning_effort=$effort"
else
    with_effort=""
fi

mail_agent_runtime codex || exit $?

MAIL_AGENT_DRIVER_HOME=$("$MAIL_AGENT_BIN/mail-agent-state" codex "$work") || exit $?

export MAIL_AGENT_DRIVER_HOME

limit=${MAIL_AGENT_TIMEOUT:-60m}
repo=$(cat "$work/project" 2>/dev/null)
access=$mode

if [ -z "$repo" ]; then
    access=research
fi

# Every invocation has private scratch; research exposes it through file tools.
mkdir -p "${MAIL_AGENT_OUTPUT_DIR:-/tmp/mail-agent}" || exit 70

MAIL_AGENT_TMP=$(mktemp -d "${MAIL_AGENT_OUTPUT_DIR:-/tmp/mail-agent}/turn.XXXXXXXX") || exit 70

export MAIL_AGENT_TMP

trap 'rm -rf "$MAIL_AGENT_TMP"' EXIT

if [ "$access" = research ]; then
    MAIL_AGENT_RESEARCH_TMP=$MAIL_AGENT_TMP

    export MAIL_AGENT_RESEARCH_TMP

    {
        printf "Research working area: %s\n" "$MAIL_AGENT_RESEARCH_TMP"
        printf "Use file tools there for downloaded contents. Do not edit CLI history.\n\n"
        cat "$prompt"
    } > "$out/context-prompt"

    prompt="$out/context-prompt"
fi

# The final message is written by codex itself, so it has to land
# somewhere the sandbox can write: the harness scratch directory is
# outside it.
last=$MAIL_AGENT_TMP/reply-$$.md

# codex's own sandbox cannot initialise inside landlock's, so landlock
# is the only one, and the distinction between a turn that may write and
# one that may not is drawn there: the clone is mounted rox rather than
# rwx for the modes that refuse edits.

# The global rules live in ~/.config/mail-agent/codex-instructions.md, to
# which CODEX_HOME/AGENTS.md is a symlink; no turn rewrites it. The mail
# rules, the same for every thread, are handed to codex as
# developer_instructions on the command line below, so they reach the
# prompt above a discovered AGENTS.md and the agent is not trusted to find
# them.

# Each turn forks the thread it answers rather than resuming it in place,
# so every response stays a point a later reply can branch from. A fork
# emits its own thread.started, captured below like any other id.
if [ -f "$work/agent-session" ]; then
    set -- exec fork "$(cat "$work/agent-session")" -
else
    set -- exec
fi

# Empty research directories must not inherit an ancestor repository's config.
if [ -z "$repo" ]; then
    set -- "$@" -c "project_root_markers=[]"
fi

if [ "$access" = research ]; then
    set -- "$@" -c "web_search=\"live\""
fi

(
    cd "$work/repo" || exit 70

    PATH="$MAIL_AGENT_EXEC_PATH" "$MAIL_AGENT_BIN/mail-agent-tools" codex "$mode" timeout "$limit" \
        "$MAIL_AGENT_BIN/mail-agent-launch" codex "$access" "$work" "$attachments" \
        "$MAIL_AGENT_EXECUTABLE" "$@" --json -o "$last" $with_model $with_effort \
        -c "developer_instructions=$(cat "$MAIL_AGENT_CONFIG/instructions.md")" \
        --dangerously-bypass-approvals-and-sandbox \
        --skip-git-repo-check < "$prompt"
) > "$work/events.jsonl" 2> "$out/stderr"

status=$?

if [ "$status" -eq 124 ]; then
    exit 124
fi

if [ "$status" -ne 0 ]; then
    tail -5 "$out/stderr" >&2
    exit 75
fi

if [ ! -s "$last" ]; then
    echo "codex wrote no final message" >&2
    tail -3 "$out/stderr" >&2
    exit 75
fi

mv "$last" "$out/reply.md"

jq -r 'select(.type=="thread.started")|.thread_id' "$work/events.jsonl" \
    | tail -1 > "$out/thread"

if [ -s "$out/thread" ]; then
    cp "$out/thread" "$work/agent-session"
fi

jq -r --arg work "$work/" -f "$MAIL_AGENT_CONFIG/steps-codex.jq" \
    "$work/events.jsonl" > "$out/steps.txt"

# Codex reports aggregate token counts rather than money. Convert its events
# to the result interface used by Claude, estimating Standard API cost at the
# selected model's published rates.
if ! jq -rs --arg model "${model:--}" \
    -f "$MAIL_AGENT_CONFIG/result-codex.jq" \
    "$work/events.jsonl" > "$out/result"; then
    exit 70
fi

"$MAIL_AGENT_BIN/mail-agent-usage" "$out/result" "$work/events.jsonl" "" \
    "$work/cost" > "$out/usage.html"

jq -r '.total_cost_usd' "$out/result" > "$out/cost"
