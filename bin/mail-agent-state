#!/bin/sh
# Prepare one stream's CLI state, importing its selected transcript and ancestors.
# Usage: mail-agent-state <driver> <work> [parent-work]

set -eu

if [ "$#" -lt 2 ] || [ "$#" -gt 3 ] || [ ! -d "$2" ]; then
    echo "usage: mail-agent-state <driver> <work> [parent-work]" >&2
    exit 64
fi

driver=$1
work=$2
parent=${3:-$work}

case "$driver" in
    claude|codex|pi) ;;
    *) echo "unknown driver: $driver" >&2; exit 64 ;;
esac

state="$work/harness/$driver"
shared="$HOME/mail/.agent/$driver"
origin="$parent/harness/$driver"
id=$(cat "$work/agent-session" 2>/dev/null || true)

case "$id" in
    *[!A-Za-z0-9_-]*) echo "invalid parent session" >&2; exit 65 ;;
esac

if [ ! -d "$origin" ]; then
    origin=$shared
fi

# Only fixed configuration files are imported from the user's CLI setup.
configuration() {
    for name in "$@"; do
        if [ -f "$shared/$name" ]; then
            cp --remove-destination "$shared/$name" "$state/$name"
        fi
    done
}

# Prefer private transcripts, then the parent stream, then legacy storage.
codex_transcript() {
    for directory in "$state" "$origin" "$shared"; do
        if [ ! -d "$directory/sessions" ]; then
            continue
        fi

        transcript=$(find "$directory/sessions" -type f \
            -name "*-$1.jsonl" -print -quit)

        if [ -n "$transcript" ]; then
            printf "%s\n" "$transcript"
            return
        fi
    done

    echo "missing Codex transcript: $1" >&2
    return 65
}

codex_transcripts() {
    ancestor=$id
    visited=" "

    while [ -n "$ancestor" ]; do
        case "$ancestor" in
            *[!A-Za-z0-9_-]*) echo "invalid ancestor session" >&2; return 65 ;;
        esac

        case "$visited" in
            *" $ancestor "*) echo "cyclic Codex ancestry" >&2; return 65 ;;
        esac

        visited="$visited$ancestor "
        transcript=$(codex_transcript "$ancestor") || return $?
        ancestor=$(jq -r 'select(.type == "session_meta") |
            .payload.forked_from_id // empty' "$transcript") || return 65

        case "$transcript" in
            "$state/sessions/"*) ;;
            *) cp -- "$transcript" "$state/sessions/" ;;
        esac
    done
}

transcripts() {
    if [ -z "$id" ] || [ "$origin" = "$state" ]; then
        return
    fi

    source="$origin/sessions"
    destination="$state/sessions"

    case "$driver" in
        claude)
            source="$origin/projects"
            encoded=$(printf "%s" "$work/repo" | sed 's|[/.]|-|g')
            destination="$state/projects/$encoded"
            ;;
        pi)
            if [ "$origin" = "$HOME/mail/.agent/pi" ]; then
                source=$origin
            fi
            ;;
    esac

    if [ ! -d "$source" ]; then
        return
    fi

    mkdir -p "$destination"
    find "$source" -type f -name "*$id.jsonl" -exec cp -- {} "$destination/" \;
}

umask 077
mkdir -p "$state/sessions"

case "$driver" in
    claude)
        configuration CLAUDE.md settings.json
        if [ -e "$shared/.credentials.json" ]; then
            ln -sfn "$shared/.credentials.json" "$state/.credentials.json"
        fi
        ;;
    codex)
        configuration AGENTS.md config.toml
        if [ -e "$shared/auth.json" ]; then
            ln -sfn "$shared/auth.json" "$state/auth.json"
        fi
        ;;
    pi)
        shared="$HOME/.pi/agent"
        configuration settings.json models.json
        if [ -d "$shared/extensions" ]; then
            ln -sfn "$shared/extensions" "$state/extensions"
        fi
        ;;
esac

case "$driver" in
    codex) codex_transcripts ;;
    *) transcripts ;;
esac

printf "%s\n" "$state"
