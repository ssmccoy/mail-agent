#!/bin/sh
#
# Render one turn of a session transcript as HTML: the reasoning, every
# tool call, and each result, in the order they happened.
#
# Usage: mail-agent-render <transcript.jsonl> <since-timestamp>

PATH=/usr/bin:/bin

export PATH

records=$1
since=$2

if [ -z "$records" ]; then
    echo "usage: mail-agent-render <records> [since]" >&2
    exit 64
fi

stream=$(mktemp "${TMPDIR:-/tmp}/mail-agent-render.XXXXXXXX") || exit 70

trap 'rm -f "$stream"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! jq -r -s --arg since "$since" \
    -f "$HOME/.config/mail-agent/render.jq" "$records" > "$stream"; then
    exit 65
fi

awk -F '\t' '
function decode(value, result, position, character, escaped) {
    result = ""

    for (position = 1; position <= length(value); position++) {
        character = substr(value, position, 1)

        if (character != "\\" || position == length(value)) {
            result = result character
            continue
        }

        escaped = substr(value, ++position, 1)

        if (escaped == "n") result = result "\n"
        else if (escaped == "r") result = result "\r"
        else if (escaped == "t") result = result "\t"
        else result = result escaped
    }

    return result
}

function escape(value) {
    gsub(/&/, "\\&amp;", value)
    gsub(/</, "\\&lt;", value)
    gsub(/>/, "\\&gt;", value)

    return value
}

function clip(value, omitted) {
    value = decode(value)

    if (length(value) <= 4000) return escape(value)

    omitted = length(value) - 4000

    return escape(substr(value, 1, 4000)) "\n\n[" omitted \
        " more characters omitted]"
}

function prose(value, result, separator, paragraph) {
    value = decode(value)
    result = ""

    while (match(value, /\n\n+/)) {
        paragraph = substr(value, 1, RSTART - 1)
        separator = result == "" ? "" : "\n"
        result = result separator "<p>" escape(paragraph) "</p>"
        value = substr(value, RSTART + RLENGTH)
    }

    separator = result == "" ? "" : "\n"

    return result separator "<p>" escape(value) "</p>"
}

BEGIN {
    print "<!doctype html>"
    print "<meta charset=\"utf-8\">"
    print "<title>Turn transcript</title>"
    print "<style>"
    print "body { font: 15px/1.6 Georgia, serif; max-width: 46rem; margin: 2rem auto; padding: 0 1rem; color: #222; }"
    print "h1 { font-size: 1.3rem; }"
    print "p { margin: .6rem 0; }"
    print "pre { font: 13px/1.45 ui-monospace, monospace; white-space: pre-wrap; word-break: break-word; }"
    print ".thought { color: #444; }"
    print ".say { border-left: 3px solid #3c763d; padding-left: .75rem; }"
    print ".call { margin: 1rem 0; }"
    print ".cmd { background: #f4f4f4; border-left: 3px solid #31708f; padding: .5rem .75rem; margin: 0; }"
    print "details.result { margin-left: .75rem; }"
    print "details.result summary { font-size: 13px; color: #666; cursor: pointer; padding: .2rem 0; }"
    print "details.result pre { background: #fafafa; padding: .4rem .75rem; color: #333; }"
    print ".meta { color: #777; font-size: 13px; }"
    print "</style>"
    print "<h1>Turn transcript</h1>"
}

$1 == "meta" {
    print "<p class=\"meta\">" $2 " records, " $3 " tool calls</p>"
}

$1 == "thinking" {
    print "<div class=\"thought\">" prose($2) "</div>"
}

$1 == "text" {
    print "<div class=\"say\">" prose($2) "</div>"
}

$1 == "call" {
    printf "<div class=\"call\"><pre class=\"cmd\">%s</pre>", clip($2)

    if ($3 > 0) {
        printf "<details class=\"result\"><summary>%s</summary>", \
            escape(decode($4))
        printf "<pre>%s</pre></details>\n", clip($5)
    }

    print "</div>"
}

END {
    print ""
}
' "$stream"
