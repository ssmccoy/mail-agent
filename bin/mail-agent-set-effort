#!/bin/sh
# Mutt editor command: replace the effort header in one draft.

if [ "$#" -ne 2 ]; then
    echo "usage: mail-agent-set-effort <default|low|medium|high|xhigh|max> <draft>" >&2
    exit 64
fi

case $1 in
    default|low|medium|high|xhigh|max) ;;
    *) echo "invalid effort: $1" >&2; exit 64 ;;
esac

size=$(wc -c < "$2") || exit
replacement=$(mktemp -- "$2.XXXXXXXX") || exit

trap 'rm -f "$replacement"' EXIT

offset=$(LC_ALL=C awk -v effort="$1" -v output="$replacement" -v size="$size" '
    { offset += length($0) + 1 }
    /^\r?$/ {
        printf "X-Mail-Effort: %s%s\n%s\n", effort, $0, $0 > output
        print offset + 1
        found = 1
        exit
    }
    !/^[ \t]/ { skip = tolower($0) ~ /^x-mail-effort:/ }
    !skip { print > output }
    END { if (!found || offset > size) exit 1 }
' < "$2") || exit

# Copy the body without changing its bytes or requiring a final newline.
tail -c "+$offset" < "$2" >> "$replacement" && mv -- "$replacement" "$2"
