#!/bin/sh
#
# Process one queued message for a session. The caller holds the
# per-session lock, so turns within a thread are strictly serial while
# separate threads run in parallel.
#
# Whichever worker wins the lock takes the oldest queued message rather
# than the one it was spawned for, which keeps arrival order even though
# flock wakeups are unordered.
#
# Usage: mail-agent-run <session-uuid>

PATH=/usr/bin:/bin:/usr/sbin
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

export PATH XDG_RUNTIME_DIR

session=$1

root="$HOME/mail/.agent"
queue="$root/queue/$session"
work="$root/work/$session"
projects="$HOME/.config/mail-agent/projects"
agents="$HOME/.config/mail-agent/agents"
limit=${MAIL_AGENT_TIMEOUT:-60m}
wrap=${MAIL_AGENT_WRAP:-72}
fqdn=$(cat /etc/mailname 2>/dev/null || hostname -f)
user=${MAIL_AGENT_USER:-$(id -un)}

if [ -z "$session" ]; then
    echo "usage: mail-agent-run <session-uuid>" >&2
    exit 64
fi

# The subject names a project up to its first colon; the map turns that
# into a repository. A reply or a forward puts its own word in front, so
# strip those first, or the project is read as "re" or "fwd".
project_key() {
    mhdr -h subject "$1" \
        | sed -E 's/^([[:space:]]*(([Rr][Ee])|([Ff][Ww][Dd]?)):[[:space:]]*)*//' \
        | sed -e 's/:.*//' \
        | tr "[:upper:]" "[:lower:]" \
        | tr -d "[:space:]"
}

# An alias names a driver and the model it runs; a model of "-" leaves
# the driver's default alone.
agent_field() {
    awk -v alias="$1" -v field="$2" \
        '$1 == alias { print $field; exit }' "$agents"
}

# The sender's own branch of that name, or failing that the one they
# know of from the repository they themselves clone.
branch_ref() {
    for ref in "refs/remotes/origin/$2" "refs/remotes/upstream/$2"; do
        if git -C "$1" rev-parse --verify --quiet "$ref" > /dev/null; then
            printf "%s\n" "$ref"
            return
        fi
    done
}

# One shared clone per repository, named for the path it came from.
shared_clone() {
    printf "%s/repos/%s\n" "$root" \
        "$(printf "%s" "$1" | sed -e "s|^/||" -e "s|/|-|g")"
}

# A version-4 id drawn from urandom, for the fork the harness starts
# itself, which has no arriving message id to adopt.
new_uuid() {
    od -An -tx1 -N16 /dev/urandom | tr -d " \n" | sed -E \
        "s/(.{8})(.{4}).(.{3}).(.{3})(.{12})/\1-\2-4\3-a\4-\5/"
}

project_repo() {
    awk -v key="$1" '$1 == key { print $2; exit }' "$projects"
}

project_keys() {
    awk '/^[^#]/ && $1 { printf "  %-20s %s\n", $1, $2 }' "$projects"
}

# Directives are lines of the form !word at the head of the body. The
# mode words say what the turn may do; !branch says which branch of the
# repository to work from.
message_mode() {
    mshow -R "$1" 2>/dev/null </dev/null \
        | sed -n 's/^!\(investigate\|plan\|execute\|research\)[[:space:]]*$/\1/p' \
        | head -1
}

message_branch() {
    mshow -R "$1" 2>/dev/null </dev/null \
        | sed -n 's/^!branch[[:space:]]\{1,\}\([^[:space:]]\{1,\}\).*$/\1/p' \
        | head -1
}

# Drop the quote a reply trails behind it, but keep quoting that has
# been answered inline: everything up to the last line the sender wrote
# themselves is theirs, and the attribution above a trailing quote goes
# with it.
message_body() {
    mshow -R "$1" 2>/dev/null </dev/null \
        | sed -e '/^!\(investigate\|plan\|execute\|research\)[[:space:]]*$/d' \
              -e '/^!branch[[:space:]]/d' \
        | awk '
            {
                line[NR] = $0

                if ($0 !~ /^>/ && $0 ~ /[^[:space:]]/) {
                    last = NR
                }
            }

            END {
                while (last > 0 &&
                       (line[last] ~ /wrote:[[:space:]]*$/ ||
                        line[last] ~ /^[[:space:]]*$/)) {
                    last--
                }

                for (i = 1; i <= last; i++) {
                    print line[i]
                }
            }'
}

permission_mode() {
    case $1 in
        execute) echo bypassPermissions ;;
        *)       echo plan ;;
    esac
}

# Reply into the thread. The id it went out under is what patches
# thread beneath, so keep it.
reply() {
    sent=$(MAIL_AGENT_REPO="$repo" "$HOME/bin/mail-agent-reply" \
        "$session" "$2" "$1")
}

message=$(ls "$queue" 2>/dev/null | sort | head -1)

if [ -z "$message" ]; then
    exit 0
fi

message="$queue/$message"
scratch=$(mktemp -d)

trap 'rm -rf "$scratch"' EXIT

# The alias is settled before the thread exists, because the answers
# that refuse a message are sent from here too and would otherwise come
# from the default. A thread that has an alias keeps it: the address a
# later message arrives on cannot move a thread to another agent.
if [ -f "$work/agent" ]; then
    agent=$(cat "$work/agent")
else
    agent=$(mhdr -h x-mail-agent "$message")
fi

if [ -z "$agent" ]; then
    agent=claude
fi

driver=$(agent_field "$agent" 2)
model=$(agent_field "$agent" 3)

if [ -z "$driver" ]; then
    driver=$agent
fi

MAIL_AGENT="$agent"

export MAIL_AGENT

# Research is asked of the web rather than of a repository. A subject
# that names a project still gets its worktree; one that names none runs
# in an empty directory instead of being refused, and the thread is
# marked as having no repository so its later turns know it.
if [ ! -d "$work" ] && [ "$(message_mode "$message")" = research ] &&
   [ -z "$(project_repo "$(project_key "$message")")" ]; then
    mkdir -p "$work/repo"
    printf "%s\n" "$agent" > "$work/agent"
    mhdr -h subject "$message" > "$work/subject"
    printf "%s\n" "$session" > "$work/root"
    : > "$work/research"
fi

# A thread's first message fixes its repository for good; later turns
# read the recorded path so an edited subject cannot re-target the agent.
if [ ! -d "$work" ]; then
    key=$(project_key "$message")
    repo=$(project_repo "$key")

    if [ -z "$repo" ] || [ ! -d "$repo/.git" ]; then
        printf "No project matches \"%s\".\n\nKnown projects:\n\n%s\n" \
            "$key" "$(project_keys)" > "$scratch/body"

        reply "$scratch/body" "$message"
        rm -f "$message"
        exit 0
    fi

    mkdir -p "$work"
    printf "%s\n" "$repo" > "$work/project"
    printf "%s\n" "$agent" > "$work/agent"
    mhdr -h subject "$message" > "$work/subject"

    # One clone per repository, shared by every thread on it, with a
    # worktree apiece. A clone of its own costs each thread the whole
    # object store to hold a checkout a fraction of its size.
    shared=$(shared_clone "$repo")

    if [ ! -d "$shared" ]; then
        git clone --quiet --bare "$repo" "$shared"
        git -C "$shared" config remote.origin.fetch \
            "+refs/heads/*:refs/remotes/origin/*"

        # A branch written by someone else is held in the source as a
        # remote-tracking ref rather than a branch, so fetching heads
        # alone hides every branch the sender has not checked out.
        git -C "$shared" config --add remote.origin.fetch \
            "+refs/remotes/origin/*:refs/remotes/upstream/*"
    fi

    # A bare clone has no remote-tracking refs until it fetches, and no
    # default branch recorded until those exist.
    git -C "$shared" fetch --quiet --prune origin
    git -C "$shared" remote set-head origin --auto > /dev/null 2>&1

    branch=$(message_branch "$message")

    if [ -z "$branch" ]; then
        branch=$(git -C "$shared" symbolic-ref --short refs/remotes/origin/HEAD \
            2>/dev/null | sed "s|^origin/||")
    fi

    start=$(branch_ref "$shared" "$branch")

    if [ -z "$start" ]; then
        printf "There is no branch \"%s\" in %s.\n" "$branch" "$repo" \
            > "$scratch/body"

        reply "$scratch/body" "$message"
        rm -rf "$work"
        rm -f "$message"
        exit 0
    fi

    # The thread commits on a branch of its own, named for the session,
    # so two threads on one branch do not contend for it.
    git -C "$shared" worktree add --quiet -b "mail/$session" \
        "$work/repo" "$start"

    printf "%s\n" "$branch" > "$work/branch"
    git -C "$work/repo" rev-parse HEAD > "$work/base"

    # A thread with no fork above it is its own root; a fork inherits this
    # below. Deletion retires everything that shares a root.
    printf "%s\n" "$session" > "$work/root"
fi

# A working directory that exists without a recorded project has lost
# its clone; say so rather than running the turn against nothing.
if [ ! -f "$work/project" ] && [ ! -f "$work/research" ]; then
    printf "%s\n%s\n" \
        "This thread's working directory is gone, so there is no clone to work in." \
        "Start a new thread to pick the work back up." > "$scratch/body"

    reply "$scratch/body" "$message"
    rm -f "$message"
    exit 0
fi

repo=$(cat "$work/project" 2>/dev/null)

# A later turn may move the thread to another branch. The patch base
# moves with it, so a series is always measured from the branch tip the
# work started on rather than from wherever the thread began. A thread
# with no repository has neither.
if [ -n "$repo" ]; then
    branch=$(message_branch "$message")
    current=$(cat "$work/branch" 2>/dev/null)
    shared=$(shared_clone "$repo")
fi

# A reply to the tip continues the thread; a reply to an earlier response
# branches from it. turns records each response with the session and the
# commit it produced, so an out-of-order reply forks both: a new thread
# whose session and worktree begin where that response did, leaving the
# original untouched.
inreplyto=$(mhdr -h in-reply-to "$message")
tip=$(tail -1 "$work/turns" 2>/dev/null | cut -d" " -f1)
fork=""

if [ -f "$work/turns" ] && [ -n "$inreplyto" ] && [ "$inreplyto" != "$tip" ]; then
    fork=$(awk -v id="$inreplyto" '$1 == id { print $2, $3; exit }' "$work/turns")
fi

if [ -n "$fork" ]; then
    parent_session=${fork% *}
    parent_commit=${fork#* }
    child=$(new_uuid)
    cwork="$root/work/$child"

    mkdir -p "$cwork"
    cp "$work/agent" "$cwork/"
    cp "$work/project" "$work/branch" "$work/research" "$cwork/" 2>/dev/null
    mhdr -h subject "$message" > "$cwork/subject"
    printf "%s\n" "$parent_session" > "$cwork/agent-session"
    printf "%s\n" "$parent_commit" > "$cwork/base"

    # The fork joins its parent's tree, so deleting either deletes both.
    { cat "$work/root" 2>/dev/null || printf "%s\n" "$session"; } > "$cwork/root"

    # A thread with no repository forks into a directory of its own
    # rather than a worktree; there is no commit to begin at.
    if [ -n "$repo" ]; then
        git -C "$shared" worktree add --quiet -b "mail/$child" \
            "$cwork/repo" "$parent_commit"
    else
        mkdir -p "$cwork/repo"
    fi

    # claude files a session under the worktree it ran in, so the fork
    # cannot resume the parent from its own new worktree until the parent
    # transcript is there. Copy it verbatim; nothing is rewritten.
    if [ "$driver" = claude ]; then
        proj="$HOME/mail/.agent/claude/projects"
        from=$(printf "%s" "$work/repo" | sed -e "s|[/.]|-|g")
        to=$(printf "%s" "$cwork/repo" | sed -e "s|[/.]|-|g")

        mkdir -p "$proj/$to"
        cp "$proj/$from/$parent_session.jsonl" "$proj/$to/" 2>/dev/null
    fi

    mkdir -p "$root/queue/$child"
    mv "$message" "$root/queue/$child/$(date +%s%N)"

    # A fork is its own thread with its own lock, so hand it to a fresh
    # worker rather than running it under this one's.
    "${MAIL_AGENT_SYSTEMD_RUN:-systemd-run}" --user --collect --quiet \
        --unit="mail-agent-$child-$(date +%s%N)" \
        flock "$root/lock/$child" "$HOME/bin/mail-agent-run" "$child"

    rmdir "$queue" 2>/dev/null

    if [ -n "$(ls -A "$queue" 2>/dev/null)" ]; then
        exec "$0" "$session"
    fi

    exit 0
fi

if [ -n "$repo" ] && [ -n "$branch" ] && [ "$branch" != "$current" ]; then
    git -C "$shared" fetch --quiet --prune origin

    start=$(branch_ref "$shared" "$branch")

    if [ -n "$start" ] &&
       git -C "$work/repo" checkout --quiet -B "mail/$session" "$start"; then
        printf "%s\n" "$branch" > "$work/branch"
        rm -f "$work/mailed"
        git -C "$work/repo" rev-parse HEAD > "$work/base"
    else
        printf "There is no branch \"%s\" in %s.\n" "$branch" "$repo" \
            > "$scratch/body"

        reply "$scratch/body" "$message"
        rm -f "$message"
        exit 0
    fi
fi

if mshow -R "$message" 2>/dev/null </dev/null | grep -q "^!details[[:space:]]*$"; then
    # Consume it first, or the thread reports itself as one message
    # behind: this request is the one waiting.
    details=$(mktemp)

    cp "$message" "$details"
    rm -f "$message"

    "$HOME/bin/mail-agent-details" "$session" > "$scratch/details"
    reply "$scratch/details" "$details"

    rm -f "$details"
    exit 0
fi

mode=$(message_mode "$message")

if [ -z "$mode" ]; then
    unknown=$(mshow -R "$message" 2>/dev/null </dev/null \
        | sed -n 's/^!\([a-z][a-z]*\).*$/\1/p' | head -1)

    # A directive that is not one of ours would otherwise fall back to
    # investigate, and the sender would be told edits are refused
    # without being told why.
    if [ -n "$unknown" ] && [ "$unknown" != "branch" ] &&
       [ "$unknown" != "details" ]; then
        printf "%s\n\n    %s\n\n%s\n" \
            "There is no !$unknown directive, so the turn did not run." \
            "!investigate  !plan  !execute  !research  !branch <name>  !details" \
            "Resend with one of those." > "$scratch/body"

        reply "$scratch/body" "$message"
        rm -f "$message"
        exit 0
    fi

    mode=investigate
fi

# A thread with no repository has nothing to commit to, so an execute
# turn there would work and deliver nothing.
if [ "$mode" = execute ] && [ -z "$repo" ]; then
    printf "%s\n%s\n" \
        "This thread has no repository, so there is nothing to execute against." \
        "Start a thread whose subject names a project to have code written." \
        > "$scratch/body"

    reply "$scratch/body" "$message"
    rm -f "$message"
    exit 0
fi

{
    printf "From: %s\n" "$(mhdr -h from "$message")"
    printf "Date: %s\n" "$(mhdr -h date "$message")"
    printf "Subject: %s\n" "$(mhdr -h subject "$message")"
    printf "Mode: %s\n" "$mode"
    printf "\n"

    message_body "$message"
} > "$scratch/prompt"

if [ -f "$work/started" ]; then
    resume="--resume"
else
    resume="--session-id"
fi

started=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)

# Plan mode writes its plan under the agent's config directory; mark the
# clock so the ones written by this turn can be told from the rest.
touch "$scratch/mark"

MAIL_AGENT_TIMEOUT="$limit" "$HOME/bin/mail-agent-$driver" \
    "$work" "$scratch" "$scratch/prompt" "$mode" "$model" \
    2> "$scratch/stderr"

status=$?

if [ "$status" -eq 124 ]; then
    printf "The turn exceeded its %s limit and was stopped.\n" "$limit" \
        > "$scratch/body"

    reply "$scratch/body" "$message"
    rm -f "$message"
    exit 0
fi

# A failure a later run could survive keeps its message queued for the
# drain; anything else consumes it, so a permanent fault cannot loop.
if [ "$status" -ne 0 ]; then
    if [ -f "$work/notified" ]; then
        exit 0
    fi

    printf "The agent could not run this turn:\n\n    %s\n\n%s\n" \
        "$(tail -3 "$scratch/stderr")" \
        "Your message is still queued and will be retried." > "$scratch/body"

    reply "$scratch/body" "$message"
    touch "$work/notified"
    exit 0
fi

rm -f "$work/notified"

printf "%s %s\n" "$started" "$(cat "$scratch/cost" 2>/dev/null || echo 0)" \
    >> "$work/cost"

# An execute turn that edited without committing delivers nothing, and
# the sender cannot see that from the reply alone.
uncommitted=$(git -C "$work/repo" status --porcelain 2>/dev/null | head -20)

if [ "$mode" = execute ] && [ -n "$uncommitted" ]; then
    {
        printf "\n\n---\n\n"
        printf "The turn left these files changed but not committed, so they\n"
        printf "are not in the patches below and were not delivered:\n\n"
        printf "%s\n" "$uncommitted" | sed "s/^/    /"
    } >> "$scratch/reply.md"
fi

# Patches are sent as messages rather than carried as an attachment, so
# a diff can be read in the pager and answered under the hunk it is
# about. mail_patches runs after the reply, which is their cover letter.
mail_patches() {
    if [ -z "$repo" ]; then
        return
    fi

    # The base moves to whatever was last sent, so a thread that commits
    # on three turns mails each commit once rather than mailing the
    # whole series again every time.
    from=$(cat "$work/mailed" 2>/dev/null || cat "$work/base")
    head=$(git -C "$work/repo" rev-parse HEAD)

    if [ "$head" = "$from" ]; then
        return
    fi

    git -C "$work/repo" format-patch --quiet --thread \
        --in-reply-to="$sent" \
        --from="$(printf "%s" "$agent" | sed "s/^./\\U&/") <$user+$agent@$fqdn>" \
        --to="$(mhdr -h from "$message")" \
        -o "$scratch/patches" "$from..HEAD"

    for patch in "$scratch"/patches/*.patch; do
        {
            printf "X-Mail-Agent: %s\n" "$agent"
            printf "X-Mail-Session: %s\n" "$session"
            printf "X-Mail-Repo: %s\n" "$repo"
            printf "Auto-Submitted: auto-replied\n"

            # format-patch writes an mbox, whose From_ line is not a
            # header and would be read as one. The message is wrapped
            # here rather than asked for: an agent that writes one long
            # line per paragraph does it every time.
            sed "1{/^From [0-9a-f]\{40\} /d;}" "$patch" \
                | "$HOME/bin/mail-agent-rewrap" "$wrap"
        } | "${MAIL_AGENT_SENDMAIL:-sendmail}" -t
    done

    printf "%s\n" "$head" > "$work/mailed"
}

# A plan is a document the sender asked for, so it travels with the
# reply rather than staying on this host.
: > "$scratch/plans"

if [ -d "$HOME/mail/.agent/$driver/plans" ]; then
    # Keep the generated name: it is what the plan is called on disk,
    # so the attachment and the file can be told to be the same one.
    find "$HOME/mail/.agent/$driver/plans" -name "*.md" -newer "$scratch/mark" | sort |
        while read -r plan; do
            name=$(basename "$plan")

            if ! pandoc -f gfm -t gfm+pipe_tables --wrap=auto --columns=79 \
                    "$plan" > "$scratch/$name" 2>/dev/null; then
                cp "$plan" "$scratch/$name"
            fi

            printf "#text/markdown;charset=UTF-8 %s>%s\n" "$scratch/$name" "$name"
        done > "$scratch/plans"
fi

# The driver wrote reply.md; rewrap it so a terminal reader is not
# scrolling sideways, and leave it as markdown for mailcap to render.
if pandoc -f gfm -t gfm+pipe_tables --wrap=auto --columns=79 \
        "$scratch/reply.md" > "$scratch/wrapped.md" 2>/dev/null; then
    mv "$scratch/wrapped.md" "$scratch/reply.md"
fi

# A reply that quoted the sender inline is already a reply. One that did
# not, a bare "Completed." to an execute, gets the sender's own words
# quoted beneath it in the usual form, so every reply reads as an answer
# to what was asked rather than a note out of context. The quote is the
# sender's message with the thread they trailed behind it dropped; the
# session already holds that history. Appended after the wrap so the
# quoting survives verbatim rather than being reflowed as a blockquote.
if ! grep -q "^>" "$scratch/reply.md"; then
    {
        printf "\n\n%s wrote:\n" "$(mhdr -h from "$message")"
        message_body "$message" | awk '$0 = "> " $0'
    } >> "$scratch/reply.md"
fi

{
    # The body is text/plain. Any other type is an attachment to a mail
    # reader, banner and all, however it is disposed; the reply is
    # already wrapped, and markdown reads as itself.
    printf "#text/plain;charset=UTF-8#inline %s>\n" "$scratch/reply.md"

    if [ -s "$scratch/plans" ]; then
        cat "$scratch/plans"
    fi

    if [ -s "$scratch/steps.txt" ]; then
        printf "#text/plain;charset=UTF-8 %s>steps.txt\n" "$scratch/steps.txt"
    fi

    if [ -s "$scratch/usage.html" ]; then
        printf "#text/html %s>usage.html\n" "$scratch/usage.html"
    fi

    if [ -s "$scratch/reasoning.html" ]; then
        printf "#text/html %s>reasoning.html\n" "$scratch/reasoning.html"
    fi
} > "$scratch/body"

reply "$scratch/body" "$message"
mail_patches

# Record the response so a later reply can tell the tip from an earlier
# point, and fork the exact session and commit that produced it.
printf "%s %s %s\n" "$sent" "$(cat "$work/agent-session" 2>/dev/null)" \
    "$(git -C "$work/repo" rev-parse HEAD 2>/dev/null || echo -)" >> "$work/turns"

rm -f "$message"
rmdir "$queue" 2>/dev/null

# Each arriving message spawns a worker, but a worker takes the oldest
# message rather than its own, so a retained message leaves one more
# message than workers. Take the next one here instead of leaving it for
# the timer.
if [ -n "$(ls -A "$queue" 2>/dev/null)" ]; then
    exec "$0" "$session"
fi

exit 0
