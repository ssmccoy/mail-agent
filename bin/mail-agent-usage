#!/bin/sh
#
# Summarise what a turn cost, from the result object the CLI prints and
# the records it wrote, as a small HTML table.
#
# Usage: mail-agent-usage <result.json> <transcript.jsonl> <since>
#                         [ledger]

PATH=/usr/bin:/bin

export PATH

result=$1
transcript=$2
since=$3
ledger=$4

if [ -z "$result" ]; then
    echo "usage: mail-agent-usage <result> <transcript> <since>" >&2
    exit 64
fi

if [ -z "$transcript" ] || [ ! -f "$transcript" ]; then
    transcript=/dev/null
fi

if [ -n "$ledger" ] && [ -f "$ledger" ]; then
    session_present=true
    session_stats=$(awk '
        length($0) > 0 { cost += $2; turns++ }
        END { printf "%d %.17g\n", turns, cost }
    ' "$ledger")
    session_turns=${session_stats%% *}
    session_cost=${session_stats#* }
else
    session_present=false
    session_turns=0
    session_cost=0
fi

stream=$(mktemp "${TMPDIR:-/tmp}/mail-agent-usage.XXXXXXXX") || exit 70

trap 'rm -f "$stream"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! jq -nr --slurpfile result "$result" \
    --slurpfile transcript "$transcript" \
    --arg since "$since" \
    --argjson session_present "$session_present" \
    --argjson session_turns "$session_turns" \
    --argjson session_cost "$session_cost" \
    -f "$HOME/.config/mail-agent/usage.jq" > "$stream"; then
    exit 65
fi

awk -F '\t' '
function decode(value, result, position, character, escaped) {
    result = ""

    for (position = 1; position <= length(value); position++) {
        character = substr(value, position, 1)

        if (character != "\\" || position == length(value)) {
            result = result character
            continue
        }

        escaped = substr(value, ++position, 1)

        if (escaped == "n") result = result "\n"
        else if (escaped == "r") result = result "\r"
        else if (escaped == "t") result = result "\t"
        else result = result escaped
    }

    return result
}

function escape(value) {
    value = decode(value)
    gsub(/&/, "\\&amp;", value)
    gsub(/</, "\\&lt;", value)

    return value
}

function count(value, digits, prefix) {
    digits = sprintf("%.0f", value)
    prefix = ""

    while (length(digits) > 3) {
        prefix = "," substr(digits, length(digits) - 2) prefix
        digits = substr(digits, 1, length(digits) - 3)
    }

    return digits prefix
}

function cost(value) {
    if (value > 0 && value < 0.01) return sprintf("$%.4f", value)

    return sprintf("$%.2f", value)
}

function cell(tag, value, numeric) {
    printf "<%s%s>%s</%s>", tag, numeric ? " class=\"n\"" : "", \
        escape(value), tag
}

function fact(name, value) {
    printf "<tr>"
    cell("td", name, 0)
    cell("td", value, 1)
    print "</tr>"
}

function model(tag, name, input, output, thinking, read, write, amount) {
    printf "<tr>"
    cell(tag, name, 0)
    cell(tag, count(input), 1)
    cell(tag, count(output), 1)
    cell(tag, count(thinking), 1)
    cell(tag, count(read), 1)
    cell(tag, count(write), 1)
    cell(tag, cost(amount), 1)
    print "</tr>"
}

function header() {
    printf "<tr>"
    cell("th", "model", 0)
    cell("th", "in", 1)
    cell("th", "out", 1)
    cell("th", "thinking", 1)
    cell("th", "cache read", 1)
    cell("th", "cache write", 1)
    cell("th", "cost", 1)
    print "</tr>"
}

BEGIN {
    print "<!doctype html>"
    print "<meta charset=\"utf-8\">"
    print "<title>Turn cost</title>"
    print "<style>"
    print "body { font: 14px/1.5 ui-monospace, monospace; margin: 1.5rem; color: #222; }"
    print "table { border-collapse: collapse; margin-bottom: 1.5rem; }"
    print "th, td { padding: .25rem .75rem; border-bottom: 1px solid #ddd; text-align: left; }"
    print "th { font-weight: normal; color: #555; }"
    print "td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }"
    print "caption { text-align: left; font-weight: bold; padding-bottom: .4rem; }"
    print "</style>"
    print "<table>"
}

$1 == "turn" {
    print "<caption>" cost($2) " this turn</caption>"
    header()
    print ""
}

$1 == "model" {
    model("td", $2, $3, $4, $5, $6, $7, $8)
    models++
    inputs += $3
    outputs += $4
    thoughts += $5
    reads += $6
    writes += $7
    costs += $8
}

$1 == "models_end" {
    if (models > 1) {
        model("th", "total", inputs, outputs, thoughts, reads, writes, costs)
    }

    print ""
    print "</table>"
    print "<table>"
}

$1 == "session" {
    if ($2 == "true") {
        fact("session so far", cost($4) " over " count($3) " " \
            ($3 == 1 ? "turn" : "turns"))
    } else {
        fact("session so far", cost($5))
    }
}

$1 == "seconds" {
    fact($2, sprintf("%.1fs", $3 / 1000))
}

$1 == "count" {
    fact($2, count($3))
}

$1 == "text" {
    fact($2, $3)
}

$1 == "subagents" {
    if ($2 > 0) {
        fact("subagents", count($2) " spawned, " count($3) " completed")
    } else {
        fact("subagents", "none")
    }
}

END {
    print ""
    print "</table>"
}
' "$stream"
