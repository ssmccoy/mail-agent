#!/bin/sh
#
# Run one turn of a mail thread with Claude and write what the harness
# needs to compose a reply.
#
# Usage: mail-agent-claude <work> <out> <prompt> <mode>
#
# Reads and writes <work>/agent-session, so the first turn starts a
# session and later turns resume it. Writes into <out>: reply.md, the
# step summary, the cost table, the rendered reasoning, and the event
# stream they are derived from.
#
# Exits 0 on success, 75 when a retry could succeed, 124 on timeout.

PATH=/usr/bin:/bin

export PATH

work=$1
out=$2
prompt=$3
mode=$4

if [ -z "$mode" ]; then
    echo "usage: mail-agent-claude <work> <out> <prompt> <mode>" >&2
    exit 64
fi

limit=${MAIL_AGENT_TIMEOUT:-60m}
config="$HOME/mail/.agent/claude"
repo=$(cat "$work/project")

permission_mode() {
    case $1 in
        execute) echo bypassPermissions ;;
        *)       echo plan ;;
    esac
}

if [ -f "$work/agent-session" ]; then
    resume="--resume"
    session=$(cat "$work/agent-session")
else
    resume="--session-id"
    session=$(od -An -tx1 -N16 /dev/urandom | tr -d " \n" | sed -E \
        "s/(.{8})(.{4}).(.{3}).(.{3})(.{12})/\1-\2-4\3-a\4-\5/")
fi

# The stream carries the whole turn: the session it ran under, every
# record the transcript would hold, and the result with its cost. The
# transcript on disk is then only history.
(
    cd "$work/repo" || exit 70

    PATH=/usr/bin timeout "$limit" "$HOME/bin/landlock" \
        -c "$HOME/.config/landlock/mail-agent-claude.cfg" -r "$repo" \
        "$HOME/.local/bin/claude" -p --output-format stream-json --verbose \
        --settings "$HOME/.config/mail-agent/claude-settings.json" \
        --permission-mode "$(permission_mode "$mode")" \
        $resume "$session" < "$prompt"
) > "$work/events.jsonl" 2> "$out/stderr"

status=$?

if [ "$status" -eq 124 ]; then
    exit 124
fi

result=$(jq -r 'select(.type=="result")|.result // empty' "$work/events.jsonl" \
    2>/dev/null | tail -1)
failed=$(jq -r 'select(.type=="result")|.is_error // false' "$work/events.jsonl" \
    2>/dev/null | tail -1)

if [ "$failed" = "true" ] || [ "$status" -ne 0 ]; then
    if [ -z "$result" ]; then
        result=$(tail -5 "$out/stderr")
    fi

    printf "%s\n" "$result" >&2
    exit 75
fi

printf "%s\n" "$session" > "$work/agent-session"
printf "%s\n" "$result" > "$out/reply.md"

jq -r --arg work "$work/" --arg since "" \
    -f "$HOME/.config/mail-agent/steps.jq" "$work/events.jsonl" \
    > "$out/steps.txt"

"$HOME/bin/mail-agent-render" "$work/events.jsonl" > "$out/reasoning.html"

jq -s 'map(select(.type=="result"))|last' "$work/events.jsonl" > "$out/result"

"$HOME/bin/mail-agent-usage" "$out/result" "$work/events.jsonl" "" \
    "$work/cost" > "$out/usage.html"

jq -r '.total_cost_usd // 0' "$out/result" > "$out/cost"
