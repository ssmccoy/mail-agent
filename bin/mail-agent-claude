#!/bin/sh
#
# Run one turn of a mail thread with Claude and write what the harness
# needs to compose a reply.
#
# Usage: mail-agent-claude <work> <out> <prompt> <mode> [model] [effort]
#
# Reads and writes <work>/agent-session, so the first turn starts a
# session and each later turn forks it. Writes into <out>: reply.md, the
# step summary, the cost table, the rendered reasoning, and the event
# stream they are derived from.
#
# Exits 0 on success, 75 when a retry could succeed, 124 on timeout.

PATH=/usr/bin:/bin

export PATH

work=$1
out=$2
prompt=$3
mode=$4
model=$5
effort=$6

if [ -z "$mode" ]; then
    echo "usage: mail-agent-claude <work> <out> <prompt> <mode> [model] [effort]" >&2
    exit 64
fi

attachments=$(dirname "$prompt")/attachments

# A model of "-", or none, leaves the CLI's own default alone.
if [ -n "$model" ] && [ "$model" != "-" ]; then
    with_model="--model $model"
else
    with_model=""
fi

# So does an effort the thread never asked for. A level the model does
# not offer is refused by the CLI, and the turn is reported as failed
# with what it said.
if [ -n "$effort" ] && [ "$effort" != "-" ]; then
    with_effort="--effort $effort"
else
    with_effort=""
fi

limit=${MAIL_AGENT_TIMEOUT:-60m}
repo=$(cat "$work/project" 2>/dev/null)
access=$mode

if [ -z "$repo" ]; then
    access=research
fi

# Research has private temporary storage and no writable checkout.
if [ "$access" = research ]; then
    mkdir -p "${MAIL_AGENT_OUTPUT_DIR:-/tmp/mail-agent}" || exit 70

    MAIL_AGENT_RESEARCH_TMP=$(mktemp -d "${MAIL_AGENT_OUTPUT_DIR:-/tmp/mail-agent}/research.XXXXXXXX") || exit 70

    export MAIL_AGENT_RESEARCH_TMP

    trap 'rm -rf "$MAIL_AGENT_RESEARCH_TMP"' EXIT
fi

# Grant the source repository only when the thread has one.
if [ -n "$repo" ]; then
    with_repo="-r $repo"

    if [ "$access" = research ]; then
        objects=$(git -C "$work/repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)

        if [ -n "$objects" ]; then
            with_repo="$with_repo -r $objects"
        fi
    fi
else
    with_repo=""
fi

if [ -d "$attachments" ]; then
    with_attachments="-r $attachments"
else
    with_attachments=""
fi

profile() {
    case $1 in
        research) echo mail-agent-claude-research ;;
        *)        echo mail-agent-claude ;;
    esac
}

permission_mode() {
    case $1 in
        execute) echo bypassPermissions ;;
        *)       echo plan ;;
    esac
}

# Each turn forks the session it answers instead of advancing it in
# place, so every response stays a point a later reply can branch from.
# agent-session names the parent to fork; its absence is the first turn.
# The fork mints its own id, read back from the stream afterward, since
# --fork-session does not take one.
if [ -f "$work/agent-session" ]; then
    session="--resume $(cat "$work/agent-session") --fork-session"
else
    session="--session-id $(od -An -tx1 -N16 /dev/urandom | tr -d " \n" | sed -E \
        "s/(.{8})(.{4}).(.{3}).(.{3})(.{12})/\1-\2-4\3-a\4-\5/")"
fi

# The mail rules are appended to the system prompt, above a discovered
# CLAUDE.md, rather than left for the agent to find. One installed file
# serves every thread, and it is passed by path: the landlock launcher
# evals its argument list, so file content on the command line would be
# re-parsed as shell. The profile grants ro of the config directory.
#
# The stream carries the whole turn: the session it ran under, every
# record the transcript would hold, and the result with its cost. The
# transcript on disk is then only history.
(
    cd "$work/repo" || exit 70

    PATH="$HOME/.proto/shims:$HOME/.proto/bin:/usr/bin" timeout "$limit" "$HOME/bin/landlock" \
        -c "$HOME/.config/landlock/$(profile "$access").cfg" $with_repo \
        $with_attachments \
        "$HOME/.local/bin/claude" -p --output-format stream-json --verbose \
        --settings "$HOME/.config/mail-agent/claude-settings.json" \
        --append-system-prompt-file "$HOME/.config/mail-agent/instructions.md" \
        --permission-mode "$(permission_mode "$mode")" \
        $with_model $with_effort $session < "$prompt"
) > "$work/events.jsonl" 2> "$out/stderr"

status=$?

if [ "$status" -eq 124 ]; then
    exit 124
fi

# The result text spans lines, so the last record is taken as a record.
# Reading the stream and keeping the last line yields whatever the model
# closed with -- a fence, a blank -- and drops the answer above it.
result=$(jq -r -s 'map(select(.type=="result"))|last|.result // empty' \
    "$work/events.jsonl" 2>/dev/null)
failed=$(jq -r -s 'map(select(.type=="result"))|last|.is_error // false' \
    "$work/events.jsonl" 2>/dev/null)

if [ "$failed" = "true" ] || [ "$status" -ne 0 ]; then
    if [ -z "$result" ]; then
        result=$(tail -5 "$out/stderr")
    fi

    printf "%s\n" "$result" >&2
    exit 75
fi

# The fork's id is not the one we passed in, so read it from the stream.
new=$(jq -r -s 'map(select(.type=="result"))|last|.session_id // empty' \
    "$work/events.jsonl")
[ -n "$new" ] && printf "%s\n" "$new" > "$work/agent-session"

printf "%s\n" "$result" > "$out/reply.md"

# AskUserQuestion reaches no one in a mail turn: the sender answers by
# mail, not at a prompt. When a turn asks through it, the final message
# is the model reacting to an unanswerable tool rather than the question,
# so mail the questions themselves instead.
if jq -e 'select(.type=="assistant")|.message.content[]?
        | select(.type=="tool_use" and .name=="AskUserQuestion")' \
        "$work/events.jsonl" > /dev/null 2>&1; then
    jq -r -s -f "$HOME/.config/mail-agent/questions.jq" \
        "$work/events.jsonl" > "$out/reply.md"
fi

jq -r --arg work "$work/" --arg since "" \
    -f "$HOME/.config/mail-agent/steps.jq" "$work/events.jsonl" \
    > "$out/steps.txt"

"$HOME/bin/mail-agent-render" "$work/events.jsonl" > "$out/reasoning.html"

jq -s 'map(select(.type=="result"))|last' "$work/events.jsonl" > "$out/result"

"$HOME/bin/mail-agent-usage" "$out/result" "$work/events.jsonl" "" \
    "$work/cost" > "$out/usage.html"

jq -r '.total_cost_usd // 0' "$out/result" > "$out/cost"
