#!/usr/bin/perl
#
# Wrap the message of a patch, leaving the patch alone.
#
# Reads a patch on standard input and writes it out with the commit
# message body wrapped, so the commit git-am writes from it is wrapped
# whatever the agent typed.
#
# Usage: mail-agent-rewrap [width] < patch > patch

use strict;
use warnings;

my $width = shift // 72;

# An indented line is a figure, a list continuation or a block of code,
# and its own width is the point of it. A line that is short already is
# left where it is: a paragraph is only rewritten when something in it
# is too long.
sub wrap {
    my ($width, @lines) = @_;

    return @lines if !grep { length > $width } @lines;
    return @lines if grep { /^\s/ } @lines;

    # A list item carries its marker on the first line and hangs the
    # rest under the text, so the marker is not read as a word.
    my $hang = "";

    if ($lines[0] =~ /^([-*+]|\d+[.)])\s+/) {
        $hang = " " x length($&);
    }

    my @wrapped;
    my $line = "";

    for my $word (split ' ', join " ", @lines) {
        my $margin = @wrapped ? $hang : "";

        if (length($margin) + length($line) + length($word) + 1 > $width
                && length $line) {
            push @wrapped, (@wrapped ? $hang : "") . $line;
            $line = $word;
        } else {
            $line = length($line) ? "$line $word" : $word;
        }
    }

    push @wrapped, (@wrapped ? $hang : "") . $line if length $line;

    return @wrapped;
}

# A line beginning a list item begins a paragraph of its own.
sub starts_item {
    return $_[0] =~ /^([-*+]|\d+[.)])\s+/;
}

my @paragraph;
my $section = "headers";

while (my $line = <STDIN>) {
    chomp $line;

    if ($section eq "headers") {
        print "$line\n";
        $section = "message" if $line eq "";
        next;
    }

    if ($section eq "diff") {
        print "$line\n";
        next;
    }

    # The three dashes end the message and begin the diffstat.
    if ($line eq "---") {
        print join("\n", wrap($width, @paragraph)), "\n" if @paragraph;
        @paragraph = ();

        print "$line\n";
        $section = "diff";
        next;
    }

    if ($line eq "") {
        print join("\n", wrap($width, @paragraph)), "\n" if @paragraph;
        @paragraph = ();

        print "\n";
        next;
    }

    if (starts_item($line) && @paragraph) {
        print join("\n", wrap($width, @paragraph)), "\n";
        @paragraph = ();
    }

    push @paragraph, $line;
}

print join("\n", wrap($width, @paragraph)), "\n" if @paragraph;
